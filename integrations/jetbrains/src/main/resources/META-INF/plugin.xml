<idea-plugin>
  <id>dev.eden.build-graph</id>
  <name>build-graph</name>
  <vendor email="devon@eden.dev" url="https://github.com/d-tietjen/build-graph">Eden</vendor>
  <description><![CDATA[
    Live Rust architecture graph from <a href="https://github.com/d-tietjen/build-graph">build-graph</a>,
    refreshed on save and opened in your browser. Shows the cross-crate architecture graph
    (crates, files, symbols, relationships) — it does not duplicate the IDE's own
    go-to-def / find-usages.
  ]]></description>

  <depends>com.intellij.modules.platform</depends>

  <extensions defaultExtensionNs="com.intellij">
    <postStartupActivity implementation="dev.eden.buildgraph.AutoStartActivity"/>
    <notificationGroup id="build-graph" displayType="BALLOON"/>
  </extensions>

  <actions>
    <group id="BuildGraph.Menu" text="Build Graph" popup="true">
      <add-to-group group-id="ToolsMenu" anchor="last"/>
      <action id="BuildGraph.OpenLiveGraph"
              class="dev.eden.buildgraph.OpenLiveGraphAction"
              text="Open Live Graph"
              description="Start the watcher (if needed) and open the live graph in your browser"/>
      <action id="BuildGraph.OpenInBrowser"
              class="dev.eden.buildgraph.OpenInBrowserAction"
              text="Reopen Graph in Browser"
              description="Open the graph tab again without restarting the watcher"/>
      <action id="BuildGraph.StopWatcher"
              class="dev.eden.buildgraph.StopWatcherAction"
              text="Stop Watching"
              description="Stop the build-graph watcher for this project"/>
      <separator/>
      <action id="BuildGraph.AutoStartToggle"
              class="dev.eden.buildgraph.AutoStartToggleAction"
              text="Auto-Start on Project Open"
              description="Automatically start watching when a Cargo project opens"/>
    </group>
  </actions>
</idea-plugin>
